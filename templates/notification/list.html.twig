{% extends 'base.html.twig' %}

{% block title %}Notifications{% endblock %}

{% block body %}
    <div class="container" style="max-width: 600px; margin: 50px auto;">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h1>Notifications</h1>
            {% if notifications|length > 0 %}
                <form method="post" action="{{ path('notifications_mark_read') }}">
                    <button type="submit" class="btn btn-sm btn-outline-primary">Mark all as read</button>
                </form>
            {% endif %}
        </div>

        {% for notification in notifications %}
            <div class="card mb-2 {% if not notification.isRead %}border-primary{% endif %}">
                <div class="card-body">
                    <div class="d-flex align-items-start">
                        <div class="flex-grow-1">
                            {% if notification.type == 'follow' %}
                                <strong>
                                    <a href="{{ path('user_profile', {username: notification.sender.username}) }}">
                                        @{{ notification.sender.username }}
                                    </a>
                                </strong>
                                started following you
                            {% elseif notification.type == 'like' %}
                                <strong>
                                    <a href="{{ path('user_profile', {username: notification.sender.username}) }}">
                                        @{{ notification.sender.username }}
                                    </a>
                                </strong>
                                liked your tweet
                                {% if notification.tweet %}
                                    <p class="text-muted mb-0 mt-1">
                                        "{{ notification.tweet.content|slice(0, 50) }}{% if notification.tweet.content|length > 50 %}...{% endif %}"
                                    </p>
                                {% endif %}
                            {% endif %}

                            <small class="text-muted d-block mt-1">
                                {{ notification.createdAt|date('d M Y H:i') }}
                            </small>
                        </div>

                        {% if not notification.isRead %}
                            <span class="badge bg-primary">New</span>
                        {% endif %}
                    </div>
                </div>
            </div>
        {% else %}
            <div class="alert alert-info">
                You have no notifications yet.
            </div>
        {% endfor %}
    </div>
{% endblock %}