{% extends 'base.html.twig' %}

{% block title %}Search: {{ query }}{% endblock %}

{% block body %}
    <div class="container" style="max-width: 600px; margin: 50px auto;">
        <h1>Search Results</h1>

        <form method="get" action="{{ path('app_search') }}" class="mb-4">
            <div class="input-group">
                <input
                        type="text"
                        name="q"
                        value="{{ query }}"
                        class="form-control"
                        placeholder="Search tweets or users..."
                        autofocus
                >
                <button class="btn btn-primary" type="submit">Search</button>
            </div>
        </form>

        {% if query %}
            <h4 class="mt-4">Users ({{ users|length }})</h4>
            {% if users %}
                <div class="list-group mb-4">
                    {% for user in users %}
                        <a href="{{ path('user_profile', {username: user.username}) }}" class="list-group-item list-group-item-action">
                            <strong>@{{ user.username }}</strong>
                            <small class="text-muted">{{ user.email }}</small>
                        </a>
                    {% endfor %}
                </div>
            {% else %}
                <p class="text-muted">No users found.</p>
            {% endif %}

            <h4 class="mt-4">Tweets ({{ tweets|length }})</h4>
            {% if tweets %}
                {% for tweet in tweets %}
                    <div class="card mb-3">
                        <div class="card-body">
                            <h6 class="card-subtitle mb-2 text-muted">
                                <a href="{{ path('user_profile', {username: tweet.user.username}) }}">
                                    @{{ tweet.user.username }}
                                </a> ·
                                {{ tweet.createdAt|date('d M Y H:i') }}
                            </h6>

                            {# YENI: Tweet content-i clickable #}
                            <a href="{{ path('tweet_show', {id: tweet.id}) }}" class="text-decoration-none text-dark">
                                <p class="card-text">{{ tweet.content }}</p>
                            </a>

                            {# YENI: Interaction buttons əlavə et #}
                            {% if app.user %}
                                <div class="mt-2">
                                    {# Like #}
                                    <button onclick="likeToggle({{ tweet.id }})" class="btn btn-sm">
                                        <span id="like-{{ tweet.id }}">
                                            {{ tweet.isLikedBy(app.user) ? '❤️' : '🤍' }}
                                        </span>
                                        <span id="count-{{ tweet.id }}">{{ tweet.likesCount }}</span>
                                    </button>

                                    {# Retweet #}
                                    <button onclick="retweetToggle({{ tweet.id }})" class="btn btn-sm">
                                        <span id="retweet-{{ tweet.id }}">
                                            {{ tweet.isRetweetedBy(app.user) ? '🔁' : '🔄' }}
                                        </span>
                                        <span id="retweet-count-{{ tweet.id }}">{{ tweet.retweetsCount }}</span>
                                    </button>

                                    {# Reply #}
                                    <a href="{{ path('tweet_show', {id: tweet.id}) }}" class="text-decoration-none">
                                        💬 {{ tweet.repliesCount }}
                                    </a>
                                </div>
                            {% else %}
                                <small class="text-muted">
                                    🤍 {{ tweet.likesCount }} ·
                                    🔄 {{ tweet.retweetsCount }} ·
                                    💬 {{ tweet.repliesCount }}
                                </small>
                            {% endif %}
                        </div>
                    </div>
                {% endfor %}
            {% else %}
                <p class="text-muted">No tweets found.</p>
            {% endif %}
        {% else %}
            <p class="text-muted">Enter at least 2 characters to search.</p>
        {% endif %}
    </div>
{% endblock %}

{% block javascripts %}
    <script>
        function likeToggle(tweetId) {
            fetch(`/tweet/${tweetId}/like`, {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'X-CSRF-Token': '{{ csrf_token("tweet_like") }}'
                }
            })
                .then(res => res.json())
                .then(data => {
                    document.getElementById(`like-${tweetId}`).innerText = data.liked ? '❤️' : '🤍';
                    document.getElementById(`count-${tweetId}`).innerText = data.count;
                })
                .catch(err => {
                    console.error('Error:', err);
                    alert('Xəta baş verdi');
                });
        }

        function retweetToggle(tweetId) {
            fetch(`/tweet/${tweetId}/retweet`, {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'X-CSRF-Token': '{{ csrf_token("tweet_retweet") }}'
                }
            })
                .then(res => res.json())
                .then(data => {
                    if (data.error) {
                        alert(data.error);
                        return;
                    }

                    document.getElementById(`retweet-${tweetId}`).innerText = data.retweeted ? '🔁' : '🔄';
                    document.getElementById(`retweet-count-${tweetId}`).innerText = data.count;
                })
                .catch(err => {
                    console.error('Error:', err);
                    alert('Xəta baş verdi');
                });
        }
    </script>
{% endblock %}