{% extends 'base.html.twig' %}

{% block title %}@{{ user.username }}{% endblock %}

{% block body %}
    <div class="container" style="max-width: 600px; margin: 50px auto;">
        <div class="card mb-4">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-start">
                    <div>
                        <h2>@{{ user.username }}</h2>
                        <p class="text-muted">{{ user.email }}</p>
                        <p>Qeydiyyat: {{ user.createdAt|date('d M Y') }}</p>
                    </div>

                    {% if app.user and app.user.id != user.id %}
                        <button onclick="followToggle('{{ user.username }}')" class="btn btn-primary" id="follow-btn-{{ user.id }}">
                            {% if app.user.isFollowing(user) %}
                                Unfollow
                            {% else %}
                                Follow
                            {% endif %}
                        </button>
                    {% endif %}
                </div>

                <div class="mt-3">
                    <strong id="followers-{{ user.id }}">{{ user.followersCount }}</strong> Followers ·
                    <strong id="following-{{ user.id }}">{{ user.followingCount }}</strong> Following ·
                    <strong>{{ tweet_count }}</strong> Tweets
                </div>
            </div>
        </div>

        <h4>Tweets</h4>

        {% for tweet in tweets %}
            <div class="card mb-3">
                <div class="card-body">
                    {# YENI: Əgər retweet-dirsə, göstər #}
                    {% if tweet.isRetweet %}
                        <small class="text-muted mb-2 d-block">
                            🔁 @{{ tweet.user.username }} retweeted
                        </small>
                        {% set displayTweet = tweet.originalTweet %}
                    {% else %}
                        {% set displayTweet = tweet %}
                    {% endif %}

                    {# Original tweet author və tarix #}
                    <h6 class="card-subtitle mb-2 text-muted">
                        <a href="{{ path('user_profile', {username: displayTweet.user.username}) }}">
                            @{{ displayTweet.user.username }}
                        </a> ·
                        {{ displayTweet.createdAt|date('d M Y H:i') }}
                    </h6>

                    <p class="card-text">{{ displayTweet.content | linkify_mentions | raw }}</p>

                    {# IMAGE DISPLAY - ƏLAVƏ EDİLDİ #}
                    {% if displayTweet.imagePath %}
                        <div class="mt-2 mb-2">
                            <img src="{{ asset('uploads/tweets/' ~ displayTweet.imagePath) }}"
                                 alt="Tweet image"
                                 class="img-fluid rounded"
                                 style="max-height: 400px; width: 100%; object-fit: cover;">
                        </div>
                    {% endif %}

                    {# Interaction buttons #}
                    {% if app.user %}
                        {# Like button #}
                        <button onclick="likeToggle({{ displayTweet.id }})" class="btn btn-sm">
                            <span id="like-{{ displayTweet.id }}">
                                {{ displayTweet.isLikedBy(app.user) ? '❤️' : '🤍' }}
                            </span>
                            <span id="count-{{ displayTweet.id }}">{{ displayTweet.likesCount }}</span>
                        </button>

                        {# Retweet button #}
                        <button onclick="retweetToggle({{ displayTweet.id }})" class="btn btn-sm">
                            <span id="retweet-{{ displayTweet.id }}">
                                {{ displayTweet.isRetweetedBy(app.user) ? '🔁' : '🔄' }}
                            </span>
                            <span id="retweet-count-{{ displayTweet.id }}">{{ displayTweet.retweetsCount }}</span>
                        </button>

                        {# Reply link #}
                        <a href="{{ path('tweet_show', {id: displayTweet.id}) }}" class="text-decoration-none">
                            💬 {{ displayTweet.repliesCount }}
                        </a>
                    {% else %}
                        <span class="text-muted">🤍 {{ displayTweet.likesCount }}</span>
                        <span class="text-muted">🔄 {{ displayTweet.retweetsCount }}</span>
                        <span class="text-muted">💬 {{ displayTweet.repliesCount }}</span>
                    {% endif %}

                    {# Delete button - yalnız ÖZ tweet-ini silə bilər #}
                    {% if app.user and tweet.user.id == app.user.id %}
                        <form method="post" action="{{ path('tweet_delete', {id: tweet.id}) }}"
                              onsubmit="return confirm('Tweet silinsin?');" style="display: inline;">
                            <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ tweet.id) }}">
                            <button type="submit" class="btn btn-sm btn-danger">Delete</button>
                        </form>
                    {% endif %}
                </div>
            </div>
        {% else %}
            <p class="text-muted">Hələ tweet yoxdur.</p>
        {% endfor %}
    </div>
{% endblock %}

{% block javascripts %}
    <script>
        function followToggle(username) {
            const btn = document.querySelector(`button[onclick="followToggle('${username}')"]`);

            fetch(`/@${username}/follow`, {
                method: 'POST',
                headers: {
                    'X-CSRF-Token': '{{ csrf_token("user_follow") }}'
                }
            })
                .then(res => res.json())
                .then(data => {
                    btn.innerText = data.following ? 'Unfollow' : 'Follow';
                    btn.classList.toggle('btn-primary', !data.following);
                    btn.classList.toggle('btn-secondary', data.following);

                    const followersEl = document.getElementById('followers-{{ user.id }}');
                    if (followersEl) followersEl.innerText = data.followers_count;
                })
                .catch(err => console.error(err));
        }

        function likeToggle(tweetId) {
            fetch(`/tweet/${tweetId}/like`, {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'X-CSRF-Token': '{{ csrf_token("tweet_like") }}'
                }
            })
                .then(res => res.json())
                .then(data => {
                    document.getElementById(`like-${tweetId}`).innerText = data.liked ? '❤️' : '🤍';
                    document.getElementById(`count-${tweetId}`).innerText = data.count;
                })
                .catch(err => {
                    console.error('Error:', err);
                    alert('Xəta baş verdi');
                });
        }

        function retweetToggle(tweetId) {
            fetch(`/tweet/${tweetId}/retweet`, {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'X-CSRF-Token': '{{ csrf_token("tweet_retweet") }}'
                }
            })
                .then(res => res.json())
                .then(data => {
                    if (data.error) {
                        alert(data.error);
                        return;
                    }

                    document.getElementById(`retweet-${tweetId}`).innerText = data.retweeted ? '🔁' : '🔄';
                    document.getElementById(`retweet-count-${tweetId}`).innerText = data.count;
                })
                .catch(err => {
                    console.error('Error:', err);
                    alert('Xəta baş verdi');
                });
        }
    </script>
{% endblock %}