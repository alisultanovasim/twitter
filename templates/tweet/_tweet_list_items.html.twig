{% for tweet in pagination %}
    <div class="card mb-3 tweet-item">
        <div class="card-body">
            {# Eyni tweet card structure (list.html.twig-dən copy et) #}
            {% if tweet.isRetweet %}
                <small class="text-muted">
                    🔁 @{{ tweet.user.username }} retweeted
                </small>
                {% set displayTweet = tweet.originalTweet %}
            {% else %}
                {% set displayTweet = tweet %}
            {% endif %}

            <h6 class="card-subtitle mb-2 text-muted">
                <a href="{{ path('user_profile', {username: displayTweet.user.username}) }}">
                    @{{ displayTweet.user.username }}
                </a> ·
                {{ displayTweet.createdAt|date('d M Y H:i') }}
            </h6>

            <a href="{{ path('tweet_show', {id: displayTweet.id}) }}" class="text-decoration-none text-dark">
                <p class="card-text">{{ displayTweet.content | linkify_mentions | raw }}</p>

                {% if displayTweet.imagePath %}
                    <img src="{{ displayTweet.imagePathForImagine | imagine_filter('tweet_thumb') }}"
                         alt="Tweet image"
                         class="img-fluid rounded mt-2"
                         style="max-width: 100%; max-height: 400px; object-fit: cover;display: block;margin-bottom: 10px">
                {% endif %}
            </a>

            {# Rest of buttons... #}
        </div>
    </div>
{% endfor %}