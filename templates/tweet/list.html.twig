{% extends 'base.html.twig' %}

{% block title %}Timeline{% endblock %}

{% block body %}
    <div class="container" style="max-width: 600px; margin: 50px auto;">
        <h1>Timeline</h1>

        {% if app.user %}
            <a href="{{ path('tweet_create') }}" class="btn btn-primary mb-3">New Tweet</a>
        {% endif %}

        {% for tweet in tweets %}
            <div class="card mb-3">
                <div class="card-body">
                    {# Əgər retweet-dirsə göstər #}
                    {% if tweet.isRetweet %}
                        <small class="text-muted">
                            🔁 @{{ tweet.user.username }} retweeted
                        </small>
                        {% set displayTweet = tweet.originalTweet %}
                    {% else %}
                        {% set displayTweet = tweet %}
                    {% endif %}

                    <h6 class="card-subtitle mb-2 text-muted">
                        <a href="{{ path('user_profile', {username: displayTweet.user.username}) }}">
                            @{{ displayTweet.user.username }}
                        </a> ·
                        {{ displayTweet.createdAt|date('d M Y H:i') }}
                    </h6>

                    {# YENI: Tweet content-i clickable #}
                    <a href="{{ path('tweet_show', {id: displayTweet.id}) }}" class="text-decoration-none text-dark">
                        <p class="card-text">{{ displayTweet.content }}</p>
                    </a>

                    {% if app.user %}
                        {# Like button #}
                        <button onclick="likeToggle({{ displayTweet.id }})" class="btn btn-sm">
                            <span id="like-{{ displayTweet.id }}">
                                {{ displayTweet.isLikedBy(app.user) ? '❤️' : '🤍' }}
                            </span>
                            <span id="count-{{ displayTweet.id }}">{{ displayTweet.likesCount }}</span>
                        </button>

                        {# Retweet button #}
                        <button onclick="retweetToggle({{ displayTweet.id }})" class="btn btn-sm">
                            <span id="retweet-{{ displayTweet.id }}">
                                {{ displayTweet.isRetweetedBy(app.user) ? '🔁' : '🔄' }}
                            </span>
                            <span id="retweet-count-{{ displayTweet.id }}">{{ displayTweet.retweetsCount }}</span>
                        </button>

                        {# Reply link #}
                        <a href="{{ path('tweet_show', {id: displayTweet.id}) }}" class="text-decoration-none">
                            💬 {{ displayTweet.repliesCount }}
                        </a>
                    {% else %}
                        <span class="text-muted">🤍 {{ displayTweet.likesCount }}</span>
                        <span class="text-muted">🔄 {{ displayTweet.retweetsCount }}</span>
                    {% endif %}

                    {# Delete button (yalnız öz tweet-i) #}
                    {% if app.user and tweet.user.id == app.user.id %}
                        <form method="post" action="{{ path('tweet_delete', {id: tweet.id}) }}"
                              onsubmit="return confirm('Tweet silinsin?');" style="display: inline;">
                            <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ tweet.id) }}">
                            <button type="submit" class="btn btn-sm btn-danger">Delete</button>
                        </form>
                    {% endif %}
                </div>
            </div>
        {% else %}
            <div class="alert alert-info">
                <p class="mb-0">Hələ heç bir tweet yoxdur.</p>
                {% if app.user %}
                    <a href="{{ path('tweet_create') }}" class="btn btn-primary mt-2">İlk Tweet-i yarat</a>
                {% else %}
                    <a href="{{ path('app_login') }}" class="btn btn-primary mt-2">Login olun</a>
                {% endif %}
            </div>
        {% endfor %}
    </div>
{% endblock %}

{% block javascripts %}
    <script>
        function likeToggle(tweetId) {
            fetch(`/tweet/${tweetId}/like`, {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'X-CSRF-Token': '{{ csrf_token("tweet_like") }}'
                }
            })
                .then(res => res.json())
                .then(data => {
                    document.getElementById(`like-${tweetId}`).innerText = data.liked ? '❤️' : '🤍';
                    document.getElementById(`count-${tweetId}`).innerText = data.count;
                })
                .catch(err => {
                    console.error('Error:', err);
                    alert('Xəta baş verdi');
                });
        }

        function retweetToggle(tweetId) {
            fetch(`/tweet/${tweetId}/retweet`, {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'X-CSRF-Token': '{{ csrf_token("tweet_retweet") }}'
                }
            })
                .then(res => res.json())
                .then(data => {
                    if (data.error) {
                        alert(data.error);
                        return;
                    }

                    document.getElementById(`retweet-${tweetId}`).innerText = data.retweeted ? '🔁' : '🔄';
                    document.getElementById(`retweet-count-${tweetId}`).innerText = data.count;
                })
                .catch(err => {
                    console.error('Error:', err);
                    alert('Xəta baş verdi');
                });
        }
    </script>
{% endblock %}