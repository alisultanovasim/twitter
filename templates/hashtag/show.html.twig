{% extends 'base.html.twig' %}

{% block title %}#{{ tag }}{% endblock %}

{% block body %}
    <div class="container" style="max-width: 600px; margin: 50px auto;">
        <a href="{{ path('hashtag_trending') }}" class="btn btn-sm btn-secondary mb-3">← Trending</a>

        <h1>#{{ tag }}</h1>
        <p class="text-muted">{{ tweets|length }} tweets</p>

        {% for tweet in tweets %}
            <div class="card mb-3">
                <div class="card-body">
                    <h6 class="card-subtitle mb-2 text-muted">
                        <a href="{{ path('user_profile', {username: tweet.user.username}) }}">
                            @{{ tweet.user.username }}
                        </a> ·
                        {{ tweet.createdAt|date('d M Y H:i') }}
                    </h6>

                    <a href="{{ path('tweet_show', {id: tweet.id}) }}" class="text-decoration-none text-dark">
                        <p class="card-text">{{ tweet.content | linkify_mentions | raw }}</p>

                        {% if tweet.imagePath %}
                            <img src="{{ tweet.imagePathForImagine | imagine_filter('tweet_thumb') }}"
                                 alt="Tweet image"
                                 class="img-fluid rounded mt-2"
                                 style="max-width: 100%; max-height: 400px; object-fit: cover;">
                        {% endif %}
                    </a>

                    {# Interaction buttons (like, retweet, reply) #}
                    {% if app.user %}
                        <button onclick="likeToggle({{ tweet.id }})" class="btn btn-sm">
                            <span id="like-{{ tweet.id }}">
                                {{ tweet.isLikedBy(app.user) ? '❤️' : '🤍' }}
                            </span>
                            <span id="count-{{ tweet.id }}">{{ tweet.likesCount }}</span>
                        </button>

                        <button onclick="retweetToggle({{ tweet.id }})" class="btn btn-sm">
                            <span id="retweet-{{ tweet.id }}">
                                {{ tweet.isRetweetedBy(app.user) ? '🔁' : '🔄' }}
                            </span>
                            <span id="retweet-count-{{ tweet.id }}">{{ tweet.retweetsCount }}</span>
                        </button>

                        <a href="{{ path('tweet_show', {id: tweet.id}) }}" class="text-decoration-none">
                            💬 {{ tweet.repliesCount }}
                        </a>
                    {% else %}
                        <span class="text-muted">🤍 {{ tweet.likesCount }}</span>
                        <span class="text-muted">🔄 {{ tweet.retweetsCount }}</span>
                        <span class="text-muted">💬 {{ tweet.repliesCount }}</span>
                    {% endif %}
                </div>
            </div>
        {% else %}
            <div class="alert alert-info">
                Bu hashtag ilə heç bir tweet yoxdur.
            </div>
        {% endfor %}
    </div>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script>
        // Like/retweet toggle functions (copy from list.html.twig)
        function likeToggle(tweetId) {
            fetch(`/tweet/${tweetId}/like`, {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'X-CSRF-Token': '{{ csrf_token("tweet_like") }}'
                }
            })
                .then(res => res.json())
                .then(data => {
                    document.getElementById(`like-${tweetId}`).innerText = data.liked ? '❤️' : '🤍';
                    document.getElementById(`count-${tweetId}`).innerText = data.count;
                })
                .catch(err => {
                    console.error('Error:', err);
                    alert('Xəta baş verdi');
                });
        }

        function retweetToggle(tweetId) {
            fetch(`/tweet/${tweetId}/retweet`, {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'X-CSRF-Token': '{{ csrf_token("tweet_retweet") }}'
                }
            })
                .then(res => res.json())
                .then(data => {
                    if (data.error) {
                        alert(data.error);
                        return;
                    }

                    document.getElementById(`retweet-${tweetId}`).innerText = data.retweeted ? '🔁' : '🔄';
                    document.getElementById(`retweet-count-${tweetId}`).innerText = data.count;
                })
                .catch(err => {
                    console.error('Error:', err);
                    alert('Xəta baş verdi');
                });
        }
    </script>
{% endblock %}